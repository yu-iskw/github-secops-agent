{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/github-secops-agent/secops-config.schema.json",
  "title": ".github-secops-agent.json",
  "description": "SecOps policy file validated by packages/ghclt validateSecopsConfig. Runtime validation may apply additional rules (e.g. case-insensitive severity, stricter login edge cases).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "organizations", "orchestration"],
  "properties": {
    "version": {
      "const": 1
    },
    "organizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "discovery"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "excludedRepositories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "discovery": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "minimumSeverity"],
            "properties": {
              "mode": {
                "type": "string",
                "minLength": 1
              },
              "minimumSeverity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              },
              "preferPerRepo": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "nudgeRounds"],
      "properties": {
        "priority": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "nudgeRounds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentTaskEscalation", "prOrCiEscalation"],
      "properties": {
        "agentTaskEscalation": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9]|-(?=[a-zA-Z0-9]))*$"
          }
        },
        "prOrCiEscalation": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9]|-(?=[a-zA-Z0-9]))*$"
          }
        },
        "byOrganization": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9]|-(?=[a-zA-Z0-9]))*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "agentTaskEscalation": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9]|-(?=[a-zA-Z0-9]))*$"
                }
              },
              "prOrCiEscalation": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9]|-(?=[a-zA-Z0-9]))*$"
                }
              }
            }
          }
        }
      }
    }
  }
}
